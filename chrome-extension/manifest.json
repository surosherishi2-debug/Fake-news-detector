{
  "manifest_version": 3,
  "name": "TruthLens-Omni | Epistemic Intelligence Verifier",
  "version": "1.3.0",
  "description": "Real-time neuro-symbolic factual verification, contextual nutrition cards, and AI hallucination detection directly in your browser.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Audit Claim with TruthLens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
